# Copy to .env and fill in locally. Do not commit .env.

# Persistence (PRD M8). Run uvicorn from backend/: sqlite:///./scoop.db
DATABASE_URL=sqlite:///./scoop.db

# Cookie session (schema: scoop_session). Local placeholder only; change before sharing the machine.
SESSION_SECRET=dev-only-change-me

# Browser origin for later CORS. No third-party API keys in v1.
FRONTEND_ORIGIN=http://localhost:5173

ADMIN_EMAIL=tori.zhao1700299-bbgm@basischina.com

# Mail. Production uses SMTP. Local tests may set MAIL_BACKEND=console (prints the code, does not send).
# SMTP_HOST is the mail server that sends the code, not this app's host or localhost.
# The process connects with STARTTLS on SMTP_PORT. Aliyun Direct Mail uses 80 (not 587).
# Do not commit real SMTP passwords.
MAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=80
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional. Super-admin CJ import from Teams. Leave blank until the keys exist.
# DeepSeek: create a key at https://platform.deepseek.com/api_keys after topping up.
# Do not commit real keys or the Teams refresh token.
DEEPSEEK_API_KEY=
TEAMS_EMAIL=tori.zhao1700299-bbgm@basischina.com
TEAMS_PASSWORD=Zxy@20100626


# Alibaba Cloud Model Studio, Beijing. Used by CJ to read a homework photo.
# Leave empty until you create a key. Do not commit a real key.


