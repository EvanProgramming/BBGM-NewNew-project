# Copy to .env and fill in locally. Do not commit .env.

# Persistence. Two databases: news/sharing content (DATABASE_URL) and CJ
# students (CORE_DATABASE_URL). When CORE_DATABASE_URL is omitted it falls back
# to DATABASE_URL, so the SQLite tests run as a single file.
# Run uvicorn from backend/: sqlite:///./scoop.db
DATABASE_URL=sqlite:///./scoop.db
# CORE_DATABASE_URL=sqlite:///./scoop.db
#
# MySQL example (two physical databases on one server):
# DATABASE_URL=mysql+pymysql://content_user:PASSWORD@HOST:3306/elegram_content?charset=utf8mb4
# CORE_DATABASE_URL=mysql+pymysql://cj_user:PASSWORD@HOST:3306/cj_student?charset=utf8mb4

# Cookie session (schema: scoop_session). Local placeholder only; change before sharing the machine.
SESSION_SECRET=dev-only-change-me

# Browser origin for later CORS. No third-party API keys in v1.
FRONTEND_ORIGIN=http://localhost:5173

# Super-admin email (lowercase). That account becomes super_admin on register or login.
# Must be @basischina.com. Leave empty until you name the person. Do not commit a real address.
ADMIN_EMAIL=

# Mail. Production uses SMTP. Local tests may set MAIL_BACKEND=console (prints the code, does not send).
# SMTP_HOST is the mail server that sends the code, not this app's host or localhost.
# The process connects with STARTTLS on SMTP_PORT. Aliyun Direct Mail uses 80 (not 587).
# Do not commit real SMTP passwords.
MAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=80
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional. Super-admin CJ import from Teams. Leave blank until the keys exist.
# DeepSeek: create a key at https://platform.deepseek.com/api_keys after topping up.
# Do not commit real keys or the Teams refresh token.
DEEPSEEK_API_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/cj/teams/callback

# Alibaba Cloud Model Studio, Beijing. Used by CJ to read a homework photo.
# Leave empty until you create a key. Do not commit a real key.
DASHSCOPE_API_KEY=
