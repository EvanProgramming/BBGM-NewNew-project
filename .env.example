# Copy to .env and fill in locally. Do not commit .env.
#
# IMPORTANT: this file is committed to the public repository. Never put a real
# password, key, or token here — any value in this file is public. Real values
# live only in your local .env (already gitignored).

# Persistence (PRD M8). Run uvicorn from backend/: sqlite:///./scoop.db
DATABASE_URL=sqlite:///./scoop.db

# Cookie session (schema: scoop_session). REQUIRED. Generate a unique value per
# environment and keep it out of this file. The app refuses to start on known
# placeholder values.
#
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
SESSION_SECRET=

# Browser origin for later CORS. No third-party API keys in v1.
FRONTEND_ORIGIN=http://localhost:5173

ADMIN_EMAIL=

# Mail. Production uses SMTP. Local tests may set MAIL_BACKEND=console (prints the code, does not send).
# SMTP_HOST is the mail server that sends the code, not this app's host or localhost.
# The process connects with STARTTLS on SMTP_PORT. Aliyun Direct Mail uses 80 (not 587).
# Do not commit real SMTP passwords.
MAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=80
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional. Super-admin CJ import from Teams. Leave blank until the keys exist.
# DeepSeek: create a key at https://platform.deepseek.com/api_keys after topping up.
# Do not commit real keys or the Teams refresh token.
DEEPSEEK_API_KEY=
TEAMS_EMAIL=
TEAMS_PASSWORD=

# Alibaba Cloud Model Studio, Beijing. Used by CJ to read a homework photo.
# Leave empty until you create a key. Do not commit a real key.
DASHSCOPE_API_KEY=

# Classroom Journal service used by the CJ sync. Do not commit a real key.
CJ_JOURNAL_BASE_URL=
CJ_JOURNAL_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional. Comma-separated public RSS URLs for forum agent topics. Empty uses the built-in BBC feeds.
NEWS_FEED_URLS=
